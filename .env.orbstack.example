# Local development only. Replace this value before sharing the environment.
AUTH_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
AUTH_JWT_ISSUER=secondhand
AUTH_JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=604800
AUTH_EMAIL_VERIFICATION_CODE_EXPIRATION_SECONDS=600
AUTH_EMAIL_INACTIVE_LOGIN_THRESHOLD_SECONDS=2592000

# Email verification is disabled unless a valid Resend key is supplied.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Acme <onboarding@resend.dev>

# Cloudflare R2 is optional for local development.
R2_ENABLED=false
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PUBLIC_BASE_URL=
R2_NOTE_PREFIX=notes
R2_AVATAR_PREFIX=avatars

# Optional geocoding identity settings.
GEOCODING_NOMINATIM_USER_AGENT=secondhand-app/1.0
GEOCODING_NOMINATIM_REFERER=
GEOCODING_NOMINATIM_CONTACT_EMAIL=
