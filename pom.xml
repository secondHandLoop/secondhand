<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.secondhand</groupId>
	<artifactId>secondhand</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<modules>
		<module>service-common</module>
		<module>service-user</module>
		<module>service-note</module>
		<module>service-message</module>
		<module>service-promotion</module>
		<module>gateway</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<spring-boot.version>3.3.4</spring-boot.version>
		<mapstruct.version>1.5.5.Final</mapstruct.version>
		<flyway.version>10.17.0</flyway.version>
		<lombok.version>1.18.36</lombok.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring-boot.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>2023.0.3</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.projectlombok</groupId>
				<artifactId>lombok</artifactId>
				<version>1.18.38</version> <!-- 使用最新版本 -->
				<scope>provided</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.8.1</version>
				<configuration>
					<source>8</source> <!-- or higher -->
					<target>8</target> <!-- or higher -->
					<parameters>true</parameters>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>1.18.38</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.3.0</version>

				<executions>
					<!-- user.json -->
					<execution>
						<id>doc-user</id>
						<phase>verify</phase>
						<goals><goal>java</goal></goals>
						<configuration>
							<mainClass>com.secondhand.common.doc.DocGenerator</mainClass>
							<!-- Use the full reactor classpath (all built modules available) -->
							<classpathScope>runtime</classpathScope>
							<arguments>
								<argument>com.secondhand.user.api</argument>
								<argument>user.json</argument>
							</arguments>
						</configuration>
					</execution>

					<!-- message.json -->
					<execution>
						<id>doc-message</id>
						<phase>verify</phase>
						<goals><goal>java</goal></goals>
						<configuration>
							<mainClass>com.secondhand.common.doc.DocGenerator</mainClass>
							<classpathScope>runtime</classpathScope>
							<arguments>
								<argument>com.secondhand.message.api</argument>
								<argument>message.json</argument>
							</arguments>
						</configuration>
					</execution>

					<!-- promotion.json -->
					<execution>
						<id>doc-promotion</id>
						<phase>verify</phase>
						<goals><goal>java</goal></goals>
						<configuration>
							<mainClass>com.secondhand.common.doc.DocGenerator</mainClass>
							<classpathScope>runtime</classpathScope>
							<arguments>
								<argument>com.secondhand.promotion.api</argument>
								<argument>promotion.json</argument>
							</arguments>
						</configuration>
					</execution>

					<!-- note.json -->
					<execution>
						<id>doc-note</id>
						<phase>verify</phase>
						<goals><goal>java</goal></goals>
						<configuration>
							<mainClass>com.secondhand.common.doc.DocGenerator</mainClass>
							<classpathScope>runtime</classpathScope>
							<arguments>
								<argument>com.secondhand.note.api</argument>
								<argument>note.json</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
			</resource>
		</resources>
	</build>
</project>
