{
  "info": {
    "_postman_id": "f2fdc4e1-59f7-4ca1-a2d3-52cebe8f4763",
    "name": "secondhand",
    "description": "Local Postman collection for auth, user, note, and message flows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register - Request Code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registerEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/register/request-code",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "register",
                "request-code"
              ]
            },
            "description": "Sends the verification email and stores `verificationToken` from the response."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('request code success', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.code).to.eql(200);",
                  "  pm.expect(json.data.verificationToken).to.exist;",
                  "  pm.environment.set('verificationToken', json.data.verificationToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Register - Verify Code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verificationToken\": \"{{verificationToken}}\",\n  \"code\": \"{{verificationCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/register/verify-code",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "register",
                "verify-code"
              ]
            },
            "description": "Set `verificationCode` in the environment from the email you receive, then run this."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('verify code success', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.code).to.eql(200);",
                  "  pm.expect(json.data.verified).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Register - Complete",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verificationToken\": \"{{verificationToken}}\",\n  \"password\": \"{{registerPassword}}\",\n  \"username\": \"{{registerUsername}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('register success', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.code).to.eql(200);",
                  "  pm.expect(json.data.accessToken).to.exist;",
                  "  pm.environment.set('accessToken', json.data.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{registerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('login response shape', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.code).to.eql(200);",
                  "  if (json.data.accessToken) {",
                  "    pm.environment.set('accessToken', json.data.accessToken);",
                  "  }",
                  "  if (json.data.verificationToken) {",
                  "    pm.environment.set('verificationToken', json.data.verificationToken);",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login - Verify Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verificationToken\": \"{{verificationToken}}\",\n  \"code\": \"{{verificationCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/login/verify-email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "login",
                "verify-email"
              ]
            },
            "description": "Run this only if `/user/login` returned `verificationRequired=true`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('login verify success', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.code).to.eql(200);",
                  "  pm.expect(json.data.accessToken).to.exist;",
                  "  pm.environment.set('accessToken', json.data.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
