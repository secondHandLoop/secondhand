          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('add message success', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.code).to.eql(200);",
                  "  pm.expect(json.data.id).to.exist;",
