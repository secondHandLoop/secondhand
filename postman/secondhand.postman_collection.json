            ],
            "url": {
              "raw": "{{baseUrl}}/message/messages?otherUserId={{otherUserId}}&page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "message",
                "messages"
              ],
              "query": [
                {
                  "key": "otherUserId",
                  "value": "{{otherUserId}}"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('list messages success', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.code).to.eql(200);",
                  "  if (!pm.environment.get('messageId') && json.data && json.data.length > 0) {",
                  "    pm.environment.set('messageId', json.data[0].id);",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
