        {
          "name": "Public List Notes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/note/notes?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "note",
                "notes"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "List My Notes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/note/notes?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "note",
                "notes"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Uses the current bearer token so drafts/private notes owned by the current user are visible."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('list notes success', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.code).to.eql(200);",
                  "  if (json.data && json.data.length > 0) {",
                  "    pm.environment.set('noteId', json.data[0].id);",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create Note With Photos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "username",
                  "value": "{{registerUsername}}",
                  "type": "text"
                },
                {
                  "key": "title",
                  "value": "{{noteTitle}}",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "{{noteDescription}}",
                  "type": "text"
                },
                {
                  "key": "state",
                  "value": "Texas",
                  "type": "text"
                },
                {
                  "key": "city",
                  "value": "Houston",
                  "type": "text"
                },
                {
                  "key": "address",
                  "value": "123 Main St",
                  "type": "text"
                },
                {
                  "key": "zipcode",
                  "value": "77001",
                  "type": "text"
                },
                {
                  "key": "price",
                  "value": "100",
                  "type": "text"
                },
                {
                  "key": "noteStatus",
                  "value": "PUBLISHED",
                  "type": "text"
                },
                {
                  "key": "topCategory",
                  "value": "FURNITURE",
                  "type": "text"
                },
                {
                  "key": "delivery",
                  "value": "true",
                  "type": "text"
                },
                {
                  "key": "photos",
                  "type": "file",
                  "src": "{{notePhotoPath}}"
                },
                {
                  "key": "photos",
                  "type": "file",
                  "src": "{{notePhotoPath2}}"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/note/notes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "note",
                "notes"
              ]
            },
            "description": "If Postman does not resolve `src` from environment variables on your setup, select the files manually in the UI before sending."
          }
        },
        {
          "name": "Edit Note - Add Or Remove Photos",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "{{noteTitle}} updated",
                  "type": "text"
                },
                {
                  "key": "deletePhotos",
                  "value": "",
                  "type": "text",
                  "description": "Paste one existing photo URL to remove. Leave blank if you are only adding."
                },
                {
                  "key": "newPhotos",
                  "type": "file",
                  "src": "{{notePhotoPath2}}"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/note/notes/{{noteId}}",
              "host": [
