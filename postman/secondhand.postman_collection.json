    {
      "name": "Message",
      "item": [
        {
          "name": "Add Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiverId\": {{otherUserId}},\n  \"content\": \"hello from Postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/message/messages",
              "host": [
                "{{baseUrl}}"
              ],
